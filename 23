* { box-sizing: border-box; }


:root {
  --bg: #f0f7f4;
  --ink: #000000;
  --muted: #000000;
  --card: #ffffff;
  --line: #cfe3da;
  --accent: #1f8a5b;
  --accent-2: #157a4d;
  --chip: #e3f0ea;
}

body {
  margin: 0;
  padding: 1.5rem;
  font-family: system-ui, -apple-system, sans-serif;
  background: var(--bg);
  color: var(--ink);
}

#game { max-width: 820px; margin: 0 auto; }

.topbar {
  display: flex;
  flex-wrap: wrap;
  gap: .75rem 1rem;
  justify-content: space-between;
  align-items: center;
  margin-bottom: .75rem;
}
h1 { margin: 0; font-size: 1.4rem; color: var(--ink); }

.hud {
  display: flex;
  gap: 1rem;
  font-variant-numeric: tabular-nums;
  font-weight: 600;
  color: var(--ink);
}

.hint { color: var(--ink); margin: 0 0 1rem; }

.organelles {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
  gap: .6rem;
  margin-bottom: 1rem;
}

.organelle {
  background: var(--card);
  border: 2px solid var(--line);
  border-radius: 10px;
  padding: .75rem .5rem;
  cursor: pointer;
  text-align: center;
  font-size: .9rem;
  color: var(--ink);
  transition: transform .1s ease, border-color .15s ease, background .15s ease;
}
.organelle:hover { border-color: var(--accent); }
.organelle:active { transform: scale(.97); }
.organelle.selected {
  background: var(--chip);
  border-color: var(--accent);
  font-weight: 600;
  color: var(--ink);
}
.organelle .icon { display: block; font-size: 1.8rem; margin-bottom: .25rem; }

.current {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: .75rem 1rem;
  margin-bottom: 1rem;
  color: var(--ink);
}
.current h2 { margin: 0 0 .5rem; font-size: 1rem; color: var(--ink); }

.chips { display: flex; flex-wrap: wrap; gap: .4rem; min-height: 1.5rem; }
.chip {
  background: var(--chip);
  padding: .25rem .6rem;
  border-radius: 999px;
  font-size: .85rem;
  color: var(--ink);
}

.combo-info { margin: .5rem 0 0; color: var(--ink); }
.combo-info.valid { color: var(--ink); font-weight: 600; }

.actions { display: flex; gap: .5rem; margin-bottom: .75rem; flex-wrap: wrap; }

button {
  font: inherit;
  padding: .7rem 1.2rem;
  border-radius: 10px;
  border: none;
  background: var(--accent);
  color: #000000;             /* было white */
  cursor: pointer;
  transition: background .15s ease;
}
button:hover:not(:disabled) { background: var(--accent-2); }
button:disabled { background: #b9c9c2; color: #000000; cursor: not-allowed; }

button.secondary { background: #cfe3da; color: #000000; }
button.secondary:hover:not(:disabled) { background: #b9d4c8; }

.message { min-height: 1.4rem; color: var(--ink); margin: 0 0 1rem; }

.upgrades, .gameover {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 1rem;
  margin-top: 1rem;
  color: var(--ink);
}
.upgrades h2, .gameover h2 { margin: 0 0 .75rem; font-size: 1.1rem; color: var(--ink); }

.upgrade-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: .75rem;
}
.upgrade {
  text-align: left;
  background: var(--chip);
  color: #000000;
  display: flex;
  flex-direction: column;
  gap: .3rem;
  padding: 1rem;
}
.upgrade:hover { background: #cfe6dc; }
.upgrade span { color: #000000; font-size: .9rem; }
.upgrade strong { font-size: 1rem; color: #000000; }

@media (max-width: 480px) {
  body { padding: 1rem; }
  .hud { font-size: .9rem; }
}
